# ─────────────────────────────────────────────────────────────
# seventwo-frontend — variables de entorno
# Local:      cp .env.example .env.local   (o .env)
# Producción: /srv/infra/seventwo/seventwo-frontend/.env.production en el VPS
# Las NEXT_PUBLIC_* se hornean al compilar: cambiarlas exige redeploy.
# ─────────────────────────────────────────────────────────────

# URL del backend (seventwo-backend)
# LOCAL:
NEXT_PUBLIC_API_URL=http://localhost:4000
# PRODUCCIÓN:
# NEXT_PUBLIC_API_URL=https://api.seventwo.tech
